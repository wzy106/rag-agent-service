# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 端到端评估（可选）
# 默认复用上面的 DeepSeek key/base_url；换 judge 模型可降低自评偏好
# ANSWER_MODEL=deepseek-chat
# JUDGE_MODEL=deepseek-chat
# JUDGE_API_KEY=your_judge_api_key
# JUDGE_BASE_URL=https://api.deepseek.com/v1

# MySQL
MYSQL_PASSWORD=your_mysql_password

# 接口鉴权（二选一）
# 单 key（简单，所有调用方属于同一租户）：
API_KEY=your-secret-key-here
# 多 key（每个 key 一个独立租户，会话/历史互相隔离，逗号分隔）：
# API_KEYS=key_alice,key_bob

# 限流（可选，默认 20 次/分钟，按 key 计）
# RATE_LIMIT_PER_MINUTE=20

# 检索/精排（可选，留空用默认值）
# RAG_RECALL_K=20              # 混合检索粗排候选数
# RAG_RERANK_MAX_LENGTH=512    # Reranker 输入截断长度
# RAG_ENABLE_RERANK=1          # 置 0 关闭精排